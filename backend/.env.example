# SQLite file used for local development; production uses a PostgreSQL connection string.
DATABASE_URL="file:./dev.db"
# Gere um segredo exclusivo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
PORT=3000
# Origens autorizadas no CORS, separadas por vírgula. Vazio = qualquer origem.
# Exemplo em produção: CORS_ORIGINS="https://seu-app.vercel.app"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
PEXELS_API_KEY=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
